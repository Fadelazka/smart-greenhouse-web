# ===== BACKEND =====
NODE_ENV=development
PORT=3001

# --- Database: Supabase (PostgreSQL + TimescaleDB) ---
# Isi SUPABASE_DB_URL dengan string koneksi PostgreSQL dari Supabase Dashboard > Database > Connection string
# Contoh: postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Kalau kosong, backend otomatis jatuh ke fallback in-memory + file JSON (backend/.data/) supaya demo tetap jalan.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi-your-anon-key-here
SUPABASE_SERVICE_KEY=eyJhbGciOi-your-service-role-key-here
SUPABASE_DB_URL=

# --- Auth ---
# Generate dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-random-64-karakter-sebelum-production
JWT_EXPIRES_IN=12h

# --- MQTT Broker ---
# false = backend TIDAK menjalankan broker sendiri, konek ke broker standalone/eksternal.
# Development: jalankan `npm run dev:broker` di terminal terpisah (mulai dari root).
# Production : ubah ke true, atau isi MQTT_URL broker cloud (Mosquitto/EMQX/HiveMQ).
MQTT_BROKER_ENABLED=false
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=
MQTT_PASSWORD=

# --- HTTP ---
CORS_ORIGIN=http://localhost:5173

# --- Alert ---
ALERT_COOLDOWN_SEC=300

# --- Cuaca real-time (F3.2, opsional) ---
# Ambil key gratis di https://openweathermap.org/api . Tanpa key, backend tetap
# start normal dan halaman Pengaturan hanya menampilkan cara mengaktifkannya.
# Key SENGAJA tidak memakai prefix VITE_ dan tidak pernah dikirim ke browser:
# request cuaca diproxy backend supaya kuota API tidak bisa dipakai pemanggil lain.
OPENWEATHER_API_KEY=

# Lokasi greenhouse, dipakai saat browser menolak izin geolokasi.
# Kosongkan keduanya kalau ingin murni mengandalkan geolokasi browser.
# Contoh Bandung: -6.9175, 107.6191
GREENHOUSE_LAT=
GREENHOUSE_LON=
# Label lokasi yang ditampilkan di overlay cuaca.
GREENHOUSE_PLACE=

# --- Notifikasi Telegram (F3.4, opsional) ---
# Token dari @BotFather, chat id dari @userinfobot atau @getidsbot.
# Penting: chat harus sudah pernah mengirim pesan ke bot, kalau tidak Telegram
# membalas "chat not found".
# Token ini setara akses penuh ke bot, jadi JANGAN pernah diisi di frontend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# false = matikan notifikasi tanpa menghapus kredensial.
TELEGRAM_ENABLED=true